# ==============================================================
# NANDINI POS ENVIRONMENT CONFIGURATION
# Ready for: Vercel (Frontend), Render (Backend), Supabase (Postgres & Storage)
# ==============================================================

# --- DJANGO BACKEND SETTINGS ---
DEBUG=False
SECRET_KEY=your-django-production-secret-key-here
ALLOWED_HOSTS=*
CORS_ALLOW_ALL=True
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com

# --- DATABASE (Supabase PostgreSQL / Render PostgreSQL) ---
# Paste your Supabase URI directly: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Alternatively, manual DB variables:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-database-password
# DB_HOST=db.[PROJECT-REF].supabase.co
# DB_PORT=5432

# --- SUPABASE STORAGE (Product Images & Store Logos) ---
# Create a public bucket in Supabase Storage named 'product-images'
SUPABASE_URL=https://xsblbcnvlvvenkifkmak.supabase.co
SUPABASE_SERVICE_KEY=sb_publishable_msPju_A3tfgZnwc1XebvDA_RDbcBzBf
SUPABASE_STORAGE_BUCKET=product-images





