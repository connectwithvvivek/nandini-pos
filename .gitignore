.installed.cfg
*.egg
MANIFEST

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
backend/media/
backend/staticfiles/
staticfiles/

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Files ---
.env
.env.*
backend/.env
backend/.env.*
frontend/.env.local
!.env.example
!backend/.env.example
!frontend/.env
!frontend/.env.production
!frontend/.env.example

